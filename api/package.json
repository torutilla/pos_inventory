{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsx dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate:create": "node-pg-migrate create -j ts --migrations-dir migrations",
    "migrate:up": "node-pg-migrate up --database-url-var DATABASE_URL --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --database-url-var DATABASE_URL --migrations-dir migrations",
    "seed": "tsx seeds/index.js"
  },
  "keywords": [],
  "author": "",
